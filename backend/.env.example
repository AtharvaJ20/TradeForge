# TradeForge backend — environment variable template
# Copy to .env and fill in values before starting the application.
# .env is gitignored. This file is committed and kept up to date.
# See docs/decisions/LOCAL-DEV-INFRASTRUCTURE.md for full mapping of
# local vs. production values.

# ---------------------------------------------------------------------------
# Database (asyncpg driver)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tradeforge_app:dev_password@localhost:5432/tradeforge_dev

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# AWS KMS — broker credential envelope encryption (ADR-002)
# Set KMS_ENDPOINT_URL to LocalStack for local dev; omit for real AWS.
# ---------------------------------------------------------------------------
KMS_ENDPOINT_URL=http://localhost:4566
KMS_KEY_ARN=arn:aws:kms:ap-south-1:000000000000:key/replace-with-local-key-id

# ---------------------------------------------------------------------------
# Transactional email
# Local: Mailpit SMTP capture (browse at http://localhost:8025)
# Production: set EMAIL_TRANSPORT=resend and supply RESEND_API_KEY + FROM_ADDRESS
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# RESEND_API_KEY=
# FROM_ADDRESS=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# CORS — exact frontend origin (no trailing slash, no wildcard)
# Local Vite dev server default:
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Application secrets
# Use any random string locally; production value from AWS Secrets Manager.
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-local-dev-only

# ---------------------------------------------------------------------------
# Cookie security
# Set to false for local HTTP dev; must be true in production (HTTPS).
# ---------------------------------------------------------------------------
SECURE_COOKIES=false
